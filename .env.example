# Required. 32 random bytes, base64. Generate with: openssl rand -base64 32
# This key encrypts staff bank account numbers. If you lose it, saved account numbers cannot be recovered.
SCHOOL_DATA_KEY=

SCHOOL_NAME=Your School Name
SCHOOL_ADDR=:8080
SCHOOL_DB=data/school.db

# true in production (HTTPS). Set to false only for local http testing.
SCHOOL_SECURE_COOKIES=true
# true only when running behind your own reverse proxy that sets X-Real-IP.
SCHOOL_TRUST_PROXY=false

# Public address of the site. Used to build the one-time setup links given to new people.
SCHOOL_BASE_URL=https://portal.yourschool.example

# Used once, only when no principal account exists yet. A one-time setup link is printed
# in the server log; open it to choose the principal's password.
SCHOOL_BOOTSTRAP_NAME=Principal
SCHOOL_BOOTSTRAP_USER=principal

# Placeholder photographs (https URL or a /static/... path). Replace with your own.
# SCHOOL_IMG_LOGIN=/static/img/login.jpg
# SCHOOL_IMG_STUDENT=/static/img/students.jpg
# SCHOOL_IMG_STAFF=/static/img/staff.jpg
